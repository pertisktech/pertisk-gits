# Copy to secret.yaml, fill token, then: kubectl apply -f deploy/k8s/runner/
# Register runner first: UI → Runners → Register (labels e.g. linux,docker)
apiVersion: v1
kind: Secret
metadata:
  name: pertisk-runner-secret
  labels:
    app.kubernetes.io/name: pertisk-runner
    app.kubernetes.io/component: ci-runner
type: Opaque
stringData:
  token: "ptr_change_me"
