# Copy to deploy/.env.runner and fill in after registering a runner in the UI.
# Register: Runners → Register runner (set labels, e.g. linux,docker)

PERTISK_API_URL=https://git.example.com
PERTISK_RUNNER_TOKEN=ptr_change_me

# Optional — colocate with git server bare repos (skip API workspace download)
# PERTISK_REPOS_ROOT=/var/lib/pertisk-gits/repos

# Set to 1 to mount host Docker socket (for runs-on: docker jobs)
RUNNER_DOCKER_SOCK=1

# Image from your registry (override tag via RUNNER_IMAGE)
# RUNNER_IMAGE=ghcr.io/example/pertisk/runner:0.1.0
