#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RELEASE_BIN="${ROOT_DIR}/target/release/pertisk-backup"
DEBUG_BIN="${ROOT_DIR}/target/debug/pertisk-backup"

if [[ -x "${RELEASE_BIN}" ]]; then
  exec "${RELEASE_BIN}" "$@"
fi

if [[ -x "${DEBUG_BIN}" ]]; then
  exec "${DEBUG_BIN}" "$@"
fi

if command -v cargo >/dev/null 2>&1; then
  exec cargo run -p pertisk-backup -- "$@"
fi

echo "ERROR: pertisk-backup binary not found and cargo is unavailable." >&2
echo "Build first: cargo build --release -p pertisk-backup" >&2
exit 1
