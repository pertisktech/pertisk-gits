# API
API_HOST=0.0.0.0
#API_PORT=8081
DATABASE_URL=postgres://pertisk:pertisk@localhost:5432/pertisk_gits
JWT_SECRET=change-me-in-production-use-a-long-random-string
REPOS_ROOT=data/repos
ARTIFACTS_ROOT=data/artifacts
GIT_PUBLIC_BASE_URL=http://localhost:8080
GIT_SSH_HOST=0.0.0.0
GIT_SSH_PORT=2222
GIT_SSH_PUBLIC_HOST=localhost
GIT_SSH_HOST_KEY_PATH=data/ssh_host_key
RUST_LOG=info,pertisk_api=debug

# Single-port deploy (UI + API + Git on one port — no gateway needed):
API_PORT=8080
GIT_PUBLIC_BASE_URL=http://localhost:8080
WEB_DIST=web/dist

# Git HTTP (Smart HTTP for clone/push)
GIT_HTTP_HOST=0.0.0.0
GIT_HTTP_PORT=8082

# Registry (Phase 5)
REGISTRY_HOST=0.0.0.0
REGISTRY_PORT=8083
REGISTRY_ROOT=data/registry
REGISTRY_PUBLIC_BASE_URL=http://localhost:8080
REGISTRY_SERVICE_NAME=pertisk-registry
REGISTRY_EMBEDDED=1
REGISTRY_UPSTREAM=127.0.0.1:8081
REGISTRY_STORAGE=local
REGISTRY_GC_ENABLED=1
REGISTRY_GC_INTERVAL_SECS=3600
# MinIO / S3 (REGISTRY_STORAGE=s3)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=pertisk-registry
# S3_ACCESS_KEY=pertisk
# S3_SECRET_KEY=pertisksecret

# SAML_SKIP_SIGNATURE_VERIFY=1

# Phase 6 — optional auth admin override (comma-separated user UUIDs)
# AUTH_ADMIN_USER_IDS=

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
API_UPSTREAM=127.0.0.1:8081
GIT_UPSTREAM=127.0.0.1:8081
