# API
API_HOST=0.0.0.0
#API_PORT=8081
# Compress JSON/HTML responses when clients send Accept-Encoding (zstd > br > gzip). Set 0 to disable.
# HTTP_COMPRESSION=1
# Default for `make dev` is DEV_DATABASE_URL in the Makefile (remote Postgres).
# Copy to .env to override, or: make dev DEV_DATABASE_URL=postgres://...
# DATABASE_URL=postgres://postgres:PASSWORD@10.1.1.233:5432/pertisk_local_gits
# Local docker Postgres: make dev-local
# DATABASE_URL=postgres://pertisk:pertisk@localhost:5432/pertisk_gits
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Comma-separated user UUIDs with platform super-admin access (optional bootstrap)
# SUPER_ADMIN_USER_IDS=
# 32-byte key for CI secrets at rest (base64 or 64-char hex). Falls back to JWT_SECRET hash in dev.
# SECRETS_ENCRYPTION_KEY=
# Max repositories per import job (UI auto-splits larger selections into multiple jobs)
# IMPORT_MAX_REPOS_PER_JOB=500
REPOS_ROOT=data/repos
SEARCH_INDEX_ROOT=data/search
ARTIFACTS_ROOT=data/artifacts
GIT_PUBLIC_BASE_URL=http://localhost:8080
GIT_SSH_HOST=0.0.0.0
GIT_SSH_PORT=2222
GIT_SSH_PUBLIC_HOST=localhost
GIT_SSH_HOST_KEY_PATH=data/ssh_host_key
# Shared secret for GET /api/v1/internal/runner-autoscale (K8s queue-depth HPA)
# RUNNER_AUTOSCALE_SECRET=

# Single-port deploy (UI + API + Git on one port — no gateway needed):
API_PORT=8080
GIT_PUBLIC_BASE_URL=http://localhost:8080
WEB_DIST=web/dist

# Git HTTP (Smart HTTP for clone/push)
GIT_HTTP_HOST=0.0.0.0
GIT_HTTP_PORT=8082

# Registry (Phase 5)
REGISTRY_HOST=0.0.0.0
REGISTRY_PORT=8083
REGISTRY_ROOT=data/registry
REGISTRY_PUBLIC_BASE_URL=http://localhost:8080
REGISTRY_SERVICE_NAME=pertisk-registry
REGISTRY_EMBEDDED=1
REGISTRY_UPSTREAM=127.0.0.1:8081
REGISTRY_STORAGE=local
REGISTRY_GC_ENABLED=1
REGISTRY_GC_INTERVAL_SECS=3600
# MinIO / S3 (REGISTRY_STORAGE=s3)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=pertisk-registry
# S3_ACCESS_KEY=pertisk
# S3_SECRET_KEY=pertisksecret

# SAML_SKIP_SIGNATURE_VERIFY=1

# Phase 6 — optional auth admin override (comma-separated user UUIDs)
# AUTH_ADMIN_USER_IDS=

# Platform super-admin (comma-separated user UUIDs; also set users.is_super_admin in DB)
# SUPER_ADMIN_USER_IDS=
# Default bootstrap user from migration: admin / admin (change in production)

# Disable public self-registration (set to 1 or true)
# DISABLE_REGISTRATION=1

# New self-registrations are pending until a super admin approves them (default).
# Set to 0 or false to auto-approve new registrations immediately.
# REQUIRE_REGISTRATION_APPROVAL=0

# BACKUPS_ROOT=data/backups

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
API_UPSTREAM=127.0.0.1:8081
GIT_UPSTREAM=127.0.0.1:8081
