# API
API_HOST=0.0.0.0
#API_PORT=8081
DATABASE_URL=postgres://pertisk:pertisk@localhost:5432/pertisk_gits
JWT_SECRET=change-me-in-production-use-a-long-random-string
REPOS_ROOT=data/repos
ARTIFACTS_ROOT=data/artifacts
GIT_PUBLIC_BASE_URL=http://localhost:8080
GIT_SSH_HOST=0.0.0.0
GIT_SSH_PORT=2222
GIT_SSH_PUBLIC_HOST=localhost
GIT_SSH_HOST_KEY_PATH=data/ssh_host_key
RUST_LOG=info,pertisk_api=debug

# Single-port deploy (UI + API + Git on one port — no gateway needed):
API_PORT=8080
GIT_PUBLIC_BASE_URL=http://localhost:8080
WEB_DIST=web/dist

# Git HTTP (Smart HTTP for clone/push)
GIT_HTTP_HOST=0.0.0.0
GIT_HTTP_PORT=8082

# Gateway (optional — only if API and WEB_DIST are not combined)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
API_UPSTREAM=127.0.0.1:8081
GIT_UPSTREAM=127.0.0.1:8081
