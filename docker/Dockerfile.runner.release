# syntax=docker/dockerfile:1
# Multi-arch runner image — buildx compiles natively per TARGETPLATFORM.
# Usage: make runner-image-multi VERSION=x.y.z

ARG TARGETPLATFORM=linux/amd64
ARG TARGETARCH=amd64
ARG VERSION=0.1.0

FROM --platform=$TARGETPLATFORM rust:1-bookworm AS builder

ARG TARGETARCH
ARG TARGETPLATFORM
ARG VERSION=0.1.0

COPY docker/apt-bookworm-install.sh /usr/local/sbin/apt-bookworm-install
RUN chmod +x /usr/local/sbin/apt-bookworm-install \
    && apt-bookworm-install \
    build-essential \
    pkg-config \
    file

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN --mount=type=cache,target=/usr/local/cargo/registry,id=pertisk-runner-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,id=pertisk-runner-git-${TARGETPLATFORM} \
    cargo fetch --locked

ARG CARGO_BUILD_JOBS=1
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
ENV PERTISK_VERSION=${VERSION}

RUN --mount=type=cache,target=/usr/local/cargo/registry,id=pertisk-runner-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,id=pertisk-runner-git-${TARGETPLATFORM} \
    --mount=type=cache,target=/app/target,id=pertisk-runner-target-${TARGETPLATFORM} \
    set -eu; \
    cargo build --release --locked -p pertisk-runner; \
    mkdir -p /app/out; \
    cp /app/target/release/pertisk-runner /app/out/pertisk-runner; \
    case "${TARGETARCH}" in \
      amd64) file /app/out/pertisk-runner | grep -Eq 'x86-64' ;; \
      arm64) file /app/out/pertisk-runner | grep -Eq 'aarch64' ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}"; exit 1 ;; \
    esac

FROM scratch AS export
COPY --from=builder /app/out/pertisk-runner /pertisk-runner

# --- Runtime image (docker build --target runtime) ---
FROM --platform=$TARGETPLATFORM debian:bookworm-slim AS runtime

ARG TARGETARCH
ARG VERSION=0.1.0
LABEL org.opencontainers.image.title="pertisk-runner" \
      org.opencontainers.image.version="${VERSION}"

COPY docker/apt-bookworm-install.sh /usr/local/sbin/apt-bookworm-install
RUN chmod +x /usr/local/sbin/apt-bookworm-install \
    && apt-bookworm-install \
    ca-certificates \
    git \
    curl \
    docker.io \
    file \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/out/pertisk-runner /usr/local/bin/pertisk-runner

RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) file /usr/local/bin/pertisk-runner | grep -Eq 'x86-64' ;; \
      arm64) file /usr/local/bin/pertisk-runner | grep -Eq 'aarch64' ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    groupadd --system pertisk-runner \
    && useradd --system --gid pertisk-runner --home-dir /var/lib/pertisk-runner \
       --shell /usr/sbin/nologin --comment "Pertisk Gits CI runner" pertisk-runner \
    && usermod -aG docker pertisk-runner \
    && mkdir -p /var/lib/pertisk-runner \
    && chown pertisk-runner:pertisk-runner /var/lib/pertisk-runner

WORKDIR /var/lib/pertisk-runner

ENV PERTISK_API_URL=http://127.0.0.1:8080 \
    RUST_LOG=info,pertisk_runner=info

USER pertisk-runner

ENTRYPOINT ["/usr/local/bin/pertisk-runner"]
CMD ["run"]
