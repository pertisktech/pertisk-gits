# Cross-compile pertisk-runner for Linux (amd64 or arm64 via buildx).
# Usage: docker buildx build --platform linux/amd64 -f docker/Dockerfile.runner.release .

ARG TARGETPLATFORM=linux/amd64
ARG BUILDPLATFORM=linux/amd64
ARG TARGETARCH=amd64
ARG BUILDARCH=amd64

FROM --platform=$BUILDPLATFORM rust:1-bookworm AS builder

ARG TARGETARCH
ARG BUILDARCH
ARG TARGETPLATFORM
ARG VERSION=0.1.0

COPY docker/apt-bookworm-install.sh /usr/local/sbin/apt-bookworm-install
RUN chmod +x /usr/local/sbin/apt-bookworm-install \
    && apt-bookworm-install \
    build-essential \
    pkg-config \
    file

RUN set -eu; \
    if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
      case "${TARGETARCH}" in \
        amd64) \
          apt-bookworm-install \
            gcc-x86-64-linux-gnu \
            libc6-dev-amd64-cross \
            linux-libc-dev-amd64-cross ;; \
        arm64) \
          apt-bookworm-install \
            gcc-aarch64-linux-gnu \
            libc6-dev-arm64-cross \
            linux-libc-dev-arm64-cross ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}"; exit 1 ;; \
      esac; \
      case "${TARGETARCH}" in \
        amd64) rustup target add x86_64-unknown-linux-gnu ;; \
        arm64) rustup target add aarch64-unknown-linux-gnu ;; \
      esac; \
    fi

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-runner-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-runner-git-${TARGETARCH} \
    cargo fetch --locked

ARG CARGO_BUILD_JOBS=1
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
ENV PERTISK_VERSION=${VERSION}

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-runner-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-runner-git-${TARGETARCH} \
    --mount=type=cache,target=/app/target,sharing=locked,id=pertisk-runner-target-${TARGETARCH} \
    set -eu; \
    case "${TARGETARCH}" in \
      amd64) RUST_TARGET=x86_64-unknown-linux-gnu ;; \
      arm64) RUST_TARGET=aarch64-unknown-linux-gnu ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    mkdir -p /app/out; \
    if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
      case "${TARGETARCH}" in \
        amd64) \
          export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc; \
          export CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc; \
          export CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++; \
          export AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar; \
          export CFLAGS_x86_64_unknown_linux_gnu="-I/usr/x86_64-linux-gnu/include"; \
          export CXXFLAGS_x86_64_unknown_linux_gnu="-I/usr/x86_64-linux-gnu/include"; \
          ;; \
        arm64) \
          export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc; \
          export CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc; \
          export CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++; \
          export AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar; \
          export CFLAGS_aarch64_unknown_linux_gnu="-I/usr/aarch64-linux-gnu/include"; \
          export CXXFLAGS_aarch64_unknown_linux_gnu="-I/usr/aarch64-linux-gnu/include"; \
          ;; \
      esac; \
      BUILD_FLAGS="--release --locked --target ${RUST_TARGET}"; \
      TARGET_DIR="/app/target/${RUST_TARGET}/release"; \
    else \
      BUILD_FLAGS="--release --locked"; \
      TARGET_DIR="/app/target/release"; \
    fi; \
    cargo build ${BUILD_FLAGS} -p pertisk-runner; \
    cp "${TARGET_DIR}/pertisk-runner" /app/out/pertisk-runner; \
    case "${TARGETARCH}" in \
      amd64) file /app/out/pertisk-runner | grep -Eq 'x86-64' ;; \
      arm64) file /app/out/pertisk-runner | grep -Eq 'aarch64' ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}"; exit 1 ;; \
    esac

FROM scratch AS export
COPY --from=builder /app/out/pertisk-runner /pertisk-runner

# --- Runtime image (docker build --target runtime) ---
FROM debian:bookworm-slim AS runtime

ARG VERSION=0.1.0
LABEL org.opencontainers.image.title="pertisk-runner" \
      org.opencontainers.image.version="${VERSION}"

COPY docker/apt-bookworm-install.sh /usr/local/sbin/apt-bookworm-install
RUN chmod +x /usr/local/sbin/apt-bookworm-install \
    && apt-bookworm-install \
    ca-certificates \
    git \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/out/pertisk-runner /usr/local/bin/pertisk-runner

RUN groupadd --system pertisk-runner \
    && useradd --system --gid pertisk-runner --home-dir /var/lib/pertisk-runner \
       --shell /usr/sbin/nologin --comment "Pertisk Gits CI runner" pertisk-runner \
    && usermod -aG docker pertisk-runner \
    && mkdir -p /var/lib/pertisk-runner \
    && chown pertisk-runner:pertisk-runner /var/lib/pertisk-runner

WORKDIR /var/lib/pertisk-runner

ENV PERTISK_API_URL=http://127.0.0.1:8080 \
    RUST_LOG=info,pertisk_runner=info

USER pertisk-runner

ENTRYPOINT ["/usr/local/bin/pertisk-runner"]
CMD ["run"]
