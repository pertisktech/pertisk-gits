# Linux environment for building .deb and .rpm with fpm.
FROM debian:bookworm-slim

COPY docker/apt-bookworm-install.sh /usr/local/sbin/apt-bookworm-install
RUN chmod +x /usr/local/sbin/apt-bookworm-install \
    && apt-bookworm-install \
      bash \
      ca-certificates \
      curl \
      ruby \
      ruby-dev \
      build-essential \
      rpm \
      cpio \
      zip \
    && gem install --no-document fpm

COPY build/deb-rpm.sh build/deb-rpm-runner.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/deb-rpm.sh /usr/local/bin/deb-rpm-runner.sh

WORKDIR /work
